@page "/"
@rendermode InteractiveServer

@* 
    --- INJECTIONS ET DÉPENDANCES ---
*@
@inject SmartDesk.Services.AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Home - SmartDesk</PageTitle>

<div class="container mt-4">
    
    @if (!Auth.IsLoggedIn)
    {
        <!-- 1. SI L'UTILISATEUR N'EST PAS CONNECTÉ -->
        <div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
            <div class="card shadow-lg border-0" style="max-width: 400px; width: 100%;">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top">
                    <h3 class="m-0 fw-bold"><i class="bi bi-shield-lock"></i> Connexion SmartDesk</h3>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Adresse mail</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input @bind="emailInput" type="email" class="form-control" placeholder="name@company.com" />
                        </div>
                        <small class="text-muted d-block mt-1">Utiliser le mail : <code>tech@smartdesk.com</code> pour passer en Technicien</small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 small">@errorMessage</div>
                    }

                    <button @onclick="HandleLogin" class="btn btn-primary w-100 btn-lg fw-bold mt-3">
                        Sign In <i class="bi bi-box-arrow-in-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }
    else if (Auth.IsTechnician)
    {
        <!-- 2. SI L'UTILISATEUR EST UN TECHNICIEN -->
        <div class="card shadow-sm border-0 p-5 text-center my-5">
            <i class="bi bi-speedometer2 display-1 text-primary mb-3"></i>
            <h2 class="fw-bold">Espace Technicien SmartDesk</h2>
            <p class="text-muted px-md-5">Bienvenue dans votre espace d'administration. Le tableau de bord avec vos statistiques sera disponible prochainement.</p>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="tickets" class="btn btn-primary btn-lg fw-bold px-4">
                    <i class="bi bi-ticket-detailed me-2"></i>Accéder à la gestion des Tickets
                </a>
                <button @onclick="HandleLogout" class="btn btn-outline-danger btn-lg fw-bold px-4">Déconnexion</button>
            </div>
        </div>
    }
    else
    {
        <!-- 3. SI L'UTILISATEUR EST UN EMPLOYÉ STANDARD -->
        <div class="card shadow-sm border-0 p-5 text-center my-5">
            <i class="bi bi-laptop display-1 text-primary mb-3"></i>
            <h2 class="fw-bold">Bienvenue dans votre espace SmartDesk</h2>
            <p class="text-muted px-md-5">Si vous avez un problème, cliquez ici pour créer un ticket.</p>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="tickets" class="btn btn-primary btn-lg fw-bold px-4">Créer un ticket</a>
                <button @onclick="HandleLogout" class="btn btn-outline-danger btn-lg fw-bold px-4">Déconnexion</button>
            </div>
        </div>
    }
</div>

@code {
    // --- 1. VARIABLES D'ÉTAT ---
    //
    private string emailInput = string.Empty; // Variable pour stocker l'email saisi par l'utilisateur dans le champ de connexion
    private string errorMessage = string.Empty; // Variable pour stocker le message d'erreur à afficher si l'email est invalide

    // --- 2. GESTION DES ÉVÉNEMENTS (BOUTONS) ---
    private void HandleLogin()
    {
        // Si l'email est vide ou ne contient pas de "@", on affiche un message d'erreur
        if (string.IsNullOrWhiteSpace(emailInput) || !emailInput.Contains("@"))
        {
            errorMessage = "Merci d'entrer une adresse mail valide.";
            return;
        }

        errorMessage = string.Empty; // Réinitialisation du message d'erreur si l'email est valide
        

        Auth.Login(emailInput); // Passe le status de l'utilisateur à connecté et stocke son email dans le service AuthService
    }

    private void HandleLogout()
    {
        Auth.Logout();
        Navigation.NavigateTo("/");
    }
}