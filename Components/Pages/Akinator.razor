@page "/akinator"
@inject SmartDesk.Data.AppDbContext DbContext
@* pour rediriger l'utilisateur vers les tickets et préremplir le ticket *@
@inject NavigationManager NavManager 
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SmartDesk.Models


<PageTitle>Akinator</PageTitle>


<input type="text" class="form-control mb-3" placeholder="Rechercher une procédure..." @bind="search" @onkeyup="HandleKeyPress" />
<button class="btn btn-primary mb-3" @onclick="SearchProcedures">Rechercher</button>
@if (procedures != null && procedures.Any())
{
    <ul class="list-group mb-3">
        @foreach (var proc in procedures)
        {
            <li class="list-group-item">
                <strong>@proc.Title</strong>
                <button class="btn btn-link" @onclick="@(() => SelectProcedureFromSearch(proc))">Voir la procédure</button>
            </li>
        }
    </ul>
}
else if (procedures != null && !procedures.Any())
{
    <div class="alert alert-warning">
         
        @if (missingFormSubmitted)
        {
            <div class="alert alert-success mt-2">
                Merci ! Votre retour a été envoyé. Nos techniciens vont créer une procédure pour ce problème.
            </div>
        }
        else if (!showMissingForm)
        {
            <p>Aucune procédure trouvée.</p>
            <button class="btn btn-warning mt-2" @onclick="() => showMissingForm = true">
                Je ne trouve pas de solution à mon problème
            </button>
        }
        else
        {
            <div class="mt-3">
                <label class="form-label">Pouvez-vous décrire brièvement votre problème ?</label>
                <textarea class="form-control mb-2" rows="3" @bind="missingDescription"></textarea>
                <button class="btn btn-success" @onclick="SubmitMissingProcedure">Envoyer au support</button>
                <button class="btn btn-secondary" @onclick="() => showMissingForm = false">Annuler</button>
            </div>
        }
    </div>
}

@if (procedure != null)
{
    <h3 class="fw-bold">Procedure : @procedure.Title</h3>
    <p>@procedure.Content</p>
    <div class="mt-3">
        <button class="btn btn-success m-2" @onclick="@(() => ProcedureResolved())">Résolu</button>
        <button class="btn btn-danger m-2" @onclick="@(() => ProcedurenotResolved())">Non résolu</button>
        <button class="btn btn-warning mt-2" @onclick="ProcedureNotRelevant">
            Cette procédure ne correspond pas à mon problème
        </button>
    </div>

    
}

else if (question != null)
{

<h3 class="fw-bold">Question : @question.Text</h3>


@foreach (var answer in question.Answers)
{
    <button class="btn btn-primary m-2" @onclick="@(() => OnAnswerClick(answer))">
        
        @answer.Text
    </button>

}
}




@code {

private Question? question;

private Procedure? procedure;

private string? search;
private List<Procedure>? procedures = null;

private bool showMissingForm = false; // pour afficher le formulaire de demande de procédure manquante
private bool missingFormSubmitted = false; // pour afficher le message de succès après soumission du formulaire
private string missingDescription = string.Empty; // pour stocker la description de la procédure manquante que l'utilisateur va taper

protected override async Task OnInitializedAsync(){
    question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == 1);
}


private async Task OnAnswerClick(Answer selectedAnswer){
    if (selectedAnswer.NextQuestionId != null)
    {
        // Si la réponse sélectionnée mène à une autre question, on charge cette question
        question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == selectedAnswer.NextQuestionId);
    }
    else if (selectedAnswer.ProcedureId != null)
    {
        // Si la réponse sélectionnée mène à une procédure, on charge cette procédure
        procedure = await DbContext.Procedures.FirstOrDefaultAsync(p => p.Id == selectedAnswer.ProcedureId); // stocke la procédure sélectionnée
        question = null; // retire la question pour afficher la procédure
    }
    
}


private async Task ProcedureResolved ()
{
    if (procedure != null)
    {
    procedure.SuccessCount++;
    await DbContext.SaveChangesAsync();
    procedure = null; // retire la procédure 
    question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == 1);

    }
}

private void ProcedurenotResolved (){

    if (procedure != null)
    {
        // On redirige vers la page /tickets en attachant l'ID de la procédure dans l'URL
        NavManager.NavigateTo($"/tickets?procedureId={procedure.Id}");
    }

}

private void ProcedureNotRelevant() // Si l'utilisateur indique que la procédure n'est pas pertinente, on réinitialise l'état
{
    // On vide la liste des procédures 
    procedures = new List<Procedure>(); 
    
    // On indique qu'on veut afficher le formulaire de "Missing Procedure"
    showMissingForm = true;
    missingFormSubmitted = false;
    
    // On efface la procédure actuellement sélectionnée pour nettoyer l'écran
    procedure = null; 
}


private async Task SearchProcedures()
{
    if (!string.IsNullOrWhiteSpace(search))
    {
        procedures = await DbContext.Procedures
            .Where(p => p.Title.Contains(search) || p.Content.Contains(search))
            .ToListAsync();
    }
    else
    {
        procedures = null;   
    }
}

private void SelectProcedureFromSearch(Procedure selectedProc)
{
    procedure = selectedProc; // écrase la procédure actuelle avec celle sélectionnée
    question = null; // retire la question pour afficher la procédure
    procedures = null; // vide la liste des procédures après la sélection
    search = ""; // vide le champ de recherche après la sélection
}

private async Task HandleKeyPress(KeyboardEventArgs e) // Gère l'événement de la touche "Entrée" pour déclencher la recherche
{
    if (e.Key == "Enter")
    {
        await SearchProcedures();
    }
}

private async Task SubmitMissingProcedure()
{
    if (!string.IsNullOrWhiteSpace(missingDescription))
    {
        var newMissingProc = new MissingProcedure
        {
            Description = missingDescription,
            SearchKeyword = string.IsNullOrWhiteSpace(search) ? null : search,
            CreatedAt = DateTime.Now,
            IsResolved = false
        };

        DbContext.MissingProcedures.Add(newMissingProc);
        await DbContext.SaveChangesAsync();

        // On affiche le message de succès et on vide le formulaire
        missingFormSubmitted = true;
        showMissingForm = false;
        missingDescription = string.Empty;
    }
}
}