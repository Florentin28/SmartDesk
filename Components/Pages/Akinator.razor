@page "/akinator"
@inject SmartDesk.Data.AppDbContext DbContext
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SmartDesk.Models


<PageTitle>Akinator</PageTitle>


<input type="text" class="form-control mb-3" placeholder="Rechercher une procédure..." @bind="search" @onkeyup="HandleKeyPress" />
<button class="btn btn-primary mb-3" @onclick="SearchProcedures">Rechercher</button>
@if (procedures != null && procedures.Any())
{
    <ul class="list-group mb-3">
        @foreach (var proc in procedures)
        {
            <li class="list-group-item">
                <strong>@proc.Title</strong>
                <button class="btn btn-link" @onclick="@(() => SelectProcedureFromSearch(proc))">Voir la procédure</button>
            </li>
        }
    </ul>
}
else if (procedures != null && !procedures.Any())
{
    <p>Aucune procédure trouvée.</p>
}

@if (procedure != null)
{
    <h3 class="fw-bold">Procedure : @procedure.Title</h3>
    <p>@procedure.Content</p>
    <div class="mt-3">
        <button class="btn btn-success m-2" @onclick="@(() => ProcedureResolved())">Résolu</button>
        <button class="btn btn-danger m-2" @onclick="@(() => ProcedurenotResolved())">Non résolu</button>
    </div>

    
}

else if (question != null)
{

<h3 class="fw-bold">Question : @question.Text</h3>


@foreach (var answer in question.Answers)
{
    <button class="btn btn-primary m-2" @onclick="@(() => OnAnswerClick(answer))">
        
        @answer.Text
    </button>

}
}




@code {

private Question? question;

private Procedure? procedure;

private string? search;
private List<Procedure>? procedures = null;

protected override async Task OnInitializedAsync(){
    question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == 1);
}


private async Task OnAnswerClick(Answer selectedAnswer){
    if (selectedAnswer.NextQuestionId != null)
    {
        // Si la réponse sélectionnée mène à une autre question, on charge cette question
        question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == selectedAnswer.NextQuestionId);
    }
    else if (selectedAnswer.ProcedureId != null)
    {
        // Si la réponse sélectionnée mène à une procédure, on charge cette procédure
        procedure = await DbContext.Procedures.FirstOrDefaultAsync(p => p.Id == selectedAnswer.ProcedureId); // stocke la procédure sélectionnée
        question = null; // retire la question pour afficher la procédure
    }
    
}


private async Task ProcedureResolved ()
{
    if (procedure != null)
    {
    procedure.SuccessCount++;
    await DbContext.SaveChangesAsync();
    procedure = null; // retire la procédure 
    question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == 1);

    }
}

private async Task ProcedurenotResolved (){
    procedure = null; // retire la procédure 
    question = await DbContext.Questions.Include(q => q.Answers).FirstOrDefaultAsync(q => q.Id == 1);

}


private async Task SearchProcedures()
{
    if (!string.IsNullOrWhiteSpace(search))
    {
        procedures = await DbContext.Procedures
            .Where(p => p.Title.Contains(search) || p.Content.Contains(search))
            .ToListAsync();
    }
    else
    {
        procedures = null;   
    }
}

private void SelectProcedureFromSearch(Procedure selectedProc)
{
    procedure = selectedProc; // écrase la procédure actuelle avec celle sélectionnée
    question = null; // retire la question pour afficher la procédure
    procedures = null; // vide la liste des procédures après la sélection
    search = ""; // vide le champ de recherche après la sélection
}

private async Task HandleKeyPress(KeyboardEventArgs e) // Gère l'événement de la touche "Entrée" pour déclencher la recherche
{
    if (e.Key == "Enter")
    {
        await SearchProcedures();
    }
}
}