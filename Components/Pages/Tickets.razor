@page "/tickets" 
@rendermode InteractiveServer // rend la page interactive
@implements IDisposable // Permet de libérer les ressources du timer quand on quitte la page

@using SmartDesk.Models 
@using SmartDesk.Data 
@using Microsoft.EntityFrameworkCore 
@using Microsoft.AspNetCore.Components.Forms @* Pour l'ajout de pièce jointe *@
@using System.IO @* Pour les chemins de dossiers *@
@using System.Timers @* Pour le timer sur les tickets *@
@inject SmartDesk.Services.AuthService Auth
@inject NavigationManager Navigation
@inject SmartDesk.Data.AppDbContext DbContext

@* Injecte l'environnement d'hébergement *@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env


<div class="container mt-4">
    
     @* Message si l'utilisateur n'est pas connecté *@
    @if (!Auth.IsLoggedIn)
    {
        <div class="alert alert-danger text-center">
            <h5><i class="bi bi-exclamation-triangle-fill"></i> Accès refusé</h5>
            <p>Vous devez être connecté pour voir cette page.</p>
            <a href="/" class="btn btn-danger">Aller à la page de connexion</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* FORMULAIRE DE CRÉATION de ticket (EMPLOYÉ) *@
            @if (!Auth.IsTechnician && !Auth.IsAdmin) // Vérifie que l'utilisateur n'est pas un technicien ou un admin pour afficher le formulaire de création de ticket
            {
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white fw-bold py-3">
                            Créer un Nouveau Ticket
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Titre du Problème</label>
                                <input @bind="newTitle" class="form-control form-control-lg" placeholder="Titre du problème" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Description Détailée</label>
                                @* @bind pour garder en mémoire le contenu de la case dès qu'il clique autre part *@
                                <textarea @bind="newDescription" class="form-control" rows="4" placeholder="Décrivez votre problème ici..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Capture d'écran (optionnel)</label>
                                <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*"/>
                            </div>
                            <button @onclick="CreateTicket" class="btn btn-primary w-100 btn-lg fw-bold mt-2"> 
                                Soumettre le Ticket
                            </button>
                        </div>
                    </div>
                </div>
            }


            

            @* TABLEAU DE BORD (DYNAMIQUE) *@
            @*  Si technicien -> Affichage 1 : 2 si ce n'est pas le cas (: signifie ELSE) *@
            <div class="@(Auth.IsTechnician || Auth.IsAdmin ? "col-12" : "col-lg-8")">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span>@(Auth.IsTechnician || Auth.IsAdmin ? "Tous les tickets" : "Vos tickets")</span>
                    <span class="badge bg-secondary">@(filteredTickets?.Count ?? 0) tickets</span> @* Compteur de tickets *@
                    </div>
                    
                    <div class="card-body p-0">
                        @* BOUTONS DE FILTRAGE (TECHNICIEN) *@
                        @if (Auth.IsTechnician || Auth.IsAdmin)
                        {
                            <div class="bg-light p-3 border-bottom d-flex gap-2">
                                <button @onclick='() => ChangeFilter("All")' class='btn btn-sm @(selectedFilter == "All" ? "btn-dark" : "btn-outline-dark") fw-semibold'>Tous</button>
                                <button @onclick='() => ChangeFilter("New")' class='btn btn-sm @(selectedFilter == "New" ? "btn-info" : "btn-outline-info") fw-semibold'>Nouveau</button>
                                <button @onclick='() => ChangeFilter("In Progress")' class='btn btn-sm @(selectedFilter == "In Progress" ? "btn-warning" : "btn-outline-warning") fw-semibold'>En Cours</button>
                                <button @onclick='() => ChangeFilter("Resolved")' class='btn btn-sm @(selectedFilter == "Resolved" ? "btn-success" : "btn-outline-success") fw-semibold'>Résolu</button>
                            </div>
                        }

                        @* Si la page est en train de charger *@
                        @if (filteredTickets == null)
                        {
                            <div class="p-4 text-center">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        }
                        @* Si aucun ticket n'est trouvé *@
                        else if (!filteredTickets.Any())
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                <span>Aucun ticket trouvé.</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 8%">ID</th>
                                            <th style="width: 47%">Détails</th>
                                            <th style="width: 15%">Statut</th>
                                            @if (Auth.IsTechnician || Auth.IsAdmin)
                                            {
                                                <th style="width: 15%">Changer Priorité</th>
                                                <th style="width: 15%">Changer Statut</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in filteredTickets)
                                        {
                                            <tr class="@GetRowPriorityClass(ticket.Priority)">
                                                <td><span class="text-muted fw-bold">#@ticket.Id</span></td>
                                                <td>
                                                    <div class="fw-bold text-dark">@ticket.Title</div>
                                                    <small class="text-muted d-block text-wrap">@ticket.Description</small>
                                                    @if (!string.IsNullOrEmpty(ticket.ScreenshotPath))
                                                        {
                                                            <div class="mt-2">
                                                                <a href="@ticket.ScreenshotPath" target="_blank" class="badge bg-secondary text-decoration-none">
                                                                    <i class="bi bi-paperclip"></i> Voir la pièce jointe
                                                                </a>
                                                            </div>
                                                        }
                                                    <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                                        <i class="bi bi-clock"></i> @ticket.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") 
                                                    <span class="text-danger fw-bold ms-2">
                                                        <i class="bi bi-hourglass-split"></i> Échéance : @GetTimeRemainingText(ticket)
                                                    </span>     
                                                    @if (Auth.IsTechnician|| Auth.IsAdmin)
                                                        {
                                                            <span> | <i class="bi bi-person"></i> By: @ticket.SubmittedBy</span>
                                                        }
                                                    </small>
                                                </td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(ticket.Status) fw-bold px-2 py-1">
                                                        @ticket.Status
                                                    </span>
                                                </td>
                                                
                                                @if (Auth.IsTechnician|| Auth.IsAdmin)
                                                {
                                                    <td>
                                                        <select value="@ticket.Priority" @onchange="(e) => UpdateTicketPriority(ticket, e.Value?.ToString())" class="form-select form-select-sm fw-semibold">
                                                            <option value="Low">Bas</option>
                                                            <option value="Medium">Moyen</option>
                                                            <option value="High">Haut</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select value="@ticket.Status" @onchange="(e) => UpdateTicketStatus(ticket, e.Value?.ToString())" class="form-select form-select-sm fw-semibold">
                                                            <option value="New">Nouveau</option>
                                                            <option value="In Progress">En Cours</option>
                                                            <option value="Resolved">Résolu</option>
                                                        </select>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Initialisation des variables vides 
    private List<Ticket>? filteredTickets; 
    private string newTitle = string.Empty; 
    private string newDescription = string.Empty; 
    private IBrowserFile? selectedFile; // Variable pour stocker le fichier sélectionné par l'utilisateur
    private string selectedFilter = "All";
    private Timer? timer; // Timer pour rafraîchir la liste des tickets toutes les secondes

    [SupplyParameterFromQuery] // Permet de récupérer l'ID de la procédure depuis l'URL pour pré-remplir le ticket
    public int? ProcedureId { get; set; } 

    
 
    // Charge les tickets de la BDD sur la page 
    protected override async Task OnInitializedAsync() 
    { 
        // Vérification de l'état de connexion
        if (!Auth.IsLoggedIn)
        {
            // Expulsion immédiate vers la page de connexion
            Navigation.NavigateTo("/");
            return;
        }

            // Si l'URL contient un ID de procédure...
        if (ProcedureId.HasValue)
        {
            // 1. On va chercher la procédure en base de données
            var failedProcedure = await DbContext.Procedures.FindAsync(ProcedureId.Value);
            
            if (failedProcedure != null)
            {
                // 2. On pré-remplit l'objet Ticket (adapte 'newTicket' avec le nom de TA variable de création)
                newTitle = $"Suite à la procédure : {failedProcedure.Title}";
                newDescription = $"J'ai bien tenté d'appliquer les étapes suivantes sans succès :\n\n{failedProcedure.Content}";
                            
            }
        }

        // Chargement des tickets depuis la base de données
        await LoadTickets(); 

        timer = new Timer(60000); // Timer qui se déclenche toutes les minutes (60000 ms)
        timer.Elapsed += (sender, e) => InvokeAsync(StateHasChanged); // Déclenche un rafraîchissement de l'interface utilisateur
        timer.Start(); // Démarre le timer
    }

    private async Task LoadTickets()
    {
        IQueryable<Ticket> query = DbContext.Tickets; @* Prépare la requête SQL des tickets *@

        if (!Auth.IsTechnician && !Auth.IsAdmin)
        {
            // L'employé ne voit STRICTEMENT que ses propres tickets 
            query = query.Where(t => t.SubmittedBy == Auth.CurrentEmail);
        }
        else if (selectedFilter != "All")
        {
            // Le technicien voit les tickets filtrés par statut si un filtre est sélectionné
            query = query.Where(t => t.Status == selectedFilter);
        }

        filteredTickets = await query.ToListAsync();
    }

    // Choisir filtre de tickets 
    private async Task ChangeFilter(string filterName)
    {
        selectedFilter = filterName;
        await LoadTickets();
    }

    // Créer un nouveau ticket 
    private async Task CreateTicket()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return; @* Vérifie que le titre n'est pas vide *@

        // On prépare une variable vide pour le chemin
        string? imagePath = null; 

        // Si l'utilisateur a bien sélectionné un fichier...
        if (selectedFile != null)
        {
        // On génère un nom unique (ex: 550e8400-e29b.png)
        var fileName = Guid.NewGuid().ToString() + Path.GetExtension(selectedFile.Name);
        
        // On trouve le chemin du dossier "uploads" dans wwwroot
        var folderPath = Path.Combine(Env.WebRootPath, "uploads");
        Directory.CreateDirectory(folderPath); // Crée le dossier s'il n'existe pas encore
        
        // On combine le dossier et le nom du fichier
        var fullPath = Path.Combine(folderPath, fileName);

        // On copie physiquement le fichier sur le disque dur (avec une limite de 5 Mo)
        using var stream = new FileStream(fullPath, FileMode.Create);
        await selectedFile.OpenReadStream(1024 * 1024 * 5).CopyToAsync(stream);

        // On garde le chemin "web" pour la base de données
        imagePath = "/uploads/" + fileName;
         }

        var ticket = new Ticket @* Prépare le tickets avec les données saisies par l'utilisateur *@
        { 
            Title = newTitle, 
            Description = newDescription,
            SubmittedBy = Auth.CurrentEmail,
            ScreenshotPath = imagePath
        };
        
        DbContext.Tickets.Add(ticket); @* Insère le ticket dans la BDD *@
        await DbContext.SaveChangesAsync(); 

        newTitle = string.Empty; @* Réinitialise les champs *@
        newDescription = string.Empty;
        selectedFile = null;
        await LoadTickets(); @* Recharge la liste des tickets *@
    }

    // Mettre à jour le statut d'un ticket 
    private async Task UpdateTicketStatus(Ticket ticket, string? nextStatus)
    {
        if (string.IsNullOrEmpty(nextStatus)) return;
        ticket.Status = nextStatus;
        await DbContext.SaveChangesAsync();

        // Si un filtre actif est sélectionné, on rafraîchit la liste pour réorganiser les éléments
        if (selectedFilter != "All")
        {
            await LoadTickets();
        }
    }

    // Met à jour la priorité du ticket 
    private async Task UpdateTicketPriority(Ticket ticket, string? nextPriority)
    {
        if (string.IsNullOrEmpty(nextPriority)) return;
        ticket.Priority = nextPriority;
        await DbContext.SaveChangesAsync();
    }

    // Change la couleur de fond du ticket suivant son Statut
    private string GetStatusBadgeClass(string status) => status switch
    {
        "New" => "bg-info text-dark",
        "In Progress" => "bg-warning text-dark",
        "Resolved" => "bg-success text-white",
        _ => "bg-secondary text-white"
    };


    // Change la couleur de fond du ticket suivant sa priorité
    private string GetRowPriorityClass(string priority) => priority switch
    {
        "Low" => "table-primary",    
        "High" => "table-danger", 
        "Medium" => "table-light",
        _ => ""                      
    };

    private void HandleFileSelected(InputFileChangeEventArgs e) // Gère la sélection d'un fichier par l'utilisateur
{
    selectedFile = e.File;
}


    public void Dispose() // Méthode pour libérer les ressources du timer
    {
            // Stop le timer et le détruit pour libérer de la RAM
            timer?.Stop();
            timer?.Dispose();
        }


    private string GetTimeRemainingText(Ticket ticket){

    TimeSpan TempsRestants = ticket.GetDeadline().ToLocalTime() - DateTime.Now.ToLocalTime();



	if (ticket.Status == "Resolved"){
	return "Résolu";
}

	else if (TempsRestants.TotalSeconds < 0){
	return "Expiré";
}
	
	else {
        if (TempsRestants.Days > 0)
        {
            return $"Temps restant : {TempsRestants.Days}J {TempsRestants.Hours}h {TempsRestants.Minutes}";
        }
        else
        {
        
            return $"Temps restant : {TempsRestants.Hours}h {TempsRestants.Minutes}";
        }

    }
    
}
    
}