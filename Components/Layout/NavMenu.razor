@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SmartDesk</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- Lien visible par TOUT LE MONDE -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Liens visibles par TOUS LES UTILISATEURS CONNECTÉS (Employé, Tech, Admin) -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Tickets
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="akinator">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Akinator
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Lien visible UNIQUEMENT par les Administrateurs -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin">
                        <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span> Admin
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Technician">
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/questions">
                <span class="bi bi-diagram-3-fill me-2" aria-hidden="true"></span> Questions
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/procedures">
                <span class="bi bi-tools me-2" aria-hidden="true"></span> Procédures
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>
    </nav>
</div>